# ─────────────────────────────────────────────────────────────────
#  Pocket Finance Genius — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha com seus valores reais.
#  NUNCA comite o arquivo .env no repositório!
# ─────────────────────────────────────────────────────────────────

# PostgreSQL — string de conexão completa
DATABASE_URL=postgres://usuario:senha@host:5432/nome_do_banco

# Habilitar SSL na conexão com o PostgreSQL
# Use "true" em produção (banco em servidor remoto) ou "false" para localhost
DATABASE_SSL=true

# Porta do servidor Express (padrão: 3001)
PORT=3001

# Segredo para assinar tokens JWT — mínimo 64 caracteres
# Gere um novo com: openssl rand -base64 64
JWT_SECRET=substitua-por-um-segredo-forte-de-64-chars-no-minimo

# Chave da API da OpenAI (necessária para o Assistente IA)
# Obtenha em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-substitua-pela-sua-chave-real

# URL do frontend (usada pelo CORS em produção)
# Ex: https://seudominio.com.br ou http://localhost:5173 para dev
FRONTEND_URL=https://seudominio.com.br

# Pluggy Open Banking — credenciais da API
# Obtenha em: https://dashboard.pluggy.ai
PLUGGY_CLIENT_ID=33298394-c199-4d74-b064-07ea5affe0c0
PLUGGY_CLIENT_SECRET=24p_09EqCUerfNca6sjiWkyO0jzWJL25rULhoLZA2FM
